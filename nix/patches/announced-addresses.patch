diff --git a/libp2p/peeraddrpolicy.nim b/libp2p/peeraddrpolicy.nim
index 740cfc0..8aaa9b5 100644
--- a/libp2p/peeraddrpolicy.nim
+++ b/libp2p/peeraddrpolicy.nim
@@ -34,3 +34,51 @@ const noPrivateAddressPolicy* = proc(ma: MultiAddress): bool {.gcsafe, raises: [
   ## neither public, circuit-relay or loopback
 
   isCircuitRelayMA(ma) or isPublicMA(ma) or isLoopbackMA(ma)
+
+# ── addresses that are invalid by construction ──────────────────────────────
+# See logos-workspace#206. A peer record that crosses the network may carry
+# *listen*-side values — the wildcard bind address and the pre-bind port
+# placeholder — that no host anywhere can dial. Each one costs every reader a
+# TCP connect and a timeout, on every discovery round.
+#
+# Both rules go through `initTAddress`, so an address that is not a wire one —
+# a circuit-relay hop, a DNS name — is never condemned by them.
+
+proc isUnspecifiedMA*(ma: MultiAddress): bool =
+  ## True for the wildcard bind address (`0.0.0.0`, `::`), which names no host.
+  let ta = initTAddress(ma).valueOr:
+    return false
+
+  case ta.family
+  of AddressFamily.IPv4:
+    ta.address_v4 == AnyAddress.address_v4
+  of AddressFamily.IPv6:
+    ta.address_v6 == AnyAddress6.address_v6
+  else:
+    false
+
+proc hasZeroPortMA*(ma: MultiAddress): bool =
+  ## True for `/tcp/0` and `/udp/0` — "bind me any free port", never a destination.
+  let ta = initTAddress(ma).valueOr:
+    return false
+
+  ta.port == Port(0)
+
+proc isDialableMA*(ma: MultiAddress): bool =
+  ## Loopback passes: it is dialable, it just reaches this host and no other.
+  not (ma.isUnspecifiedMA() or ma.hasZeroPortMA())
+
+proc isRoutableMA*(ma: MultiAddress): bool =
+  ma.isDialableMA() and not ma.isLoopbackMA()
+
+const dialableAddressPolicy* = proc(ma: MultiAddress): bool {.gcsafe, raises: [].} =
+  ## Drops only what cannot be dialled from any host: unspecified host, port 0.
+
+  isDialableMA(ma)
+
+const routableAddressPolicy* = proc(ma: MultiAddress): bool {.gcsafe, raises: [].} =
+  ## `dialableAddressPolicy`, and loopback too. A record carrying loopback
+  ## reaches whichever host reads it, which is never the one that published it;
+  ## on a physical device it can only ever be a node inside the same app.
+
+  isRoutableMA(ma)
